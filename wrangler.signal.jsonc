{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tako-signal-relay",
  "main": "worker/signal-relay.mjs",
  "compatibility_date": "2026-09-07",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "SignalRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SignalRoom"]
    }
  ]
}
